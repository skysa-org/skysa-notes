{
  "name": "@skysa/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/app.ts"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply skysa-notes --local",
    "db:migrate:remote": "wrangler d1 migrations apply skysa-notes --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@skysa/core": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}

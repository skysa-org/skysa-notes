{
	"name": "@skysa/api",
	"version": "2.1.1",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./relay": "./src/relay.ts"
	},
	"scripts": {
		"dev": "wrangler dev --port 8787",
		"build": "wrangler deploy --dry-run --outdir dist",
		"deploy": "wrangler deploy",
		"deploy:migrate": "wrangler d1 migrations apply skysa-notes --remote && wrangler deploy",
		"typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.src.json --noEmit",
		"test": "vitest run",
		"cf-typegen": "wrangler types --env-file ../../.dev.vars.example",
		"db:migrate": "wrangler d1 migrations apply skysa-notes --local",
		"db:migrate:remote": "wrangler d1 migrations apply skysa-notes --remote"
	},
	"dependencies": {
		"@skysa/core": "workspace:*",
		"@skysa/server": "0.2.0",
		"@skysa/storage": "0.2.0"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"vitest": "catalog:",
		"wrangler": "^4.149.0"
	}
}

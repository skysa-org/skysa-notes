{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"types": ["vite/client", "vite-plugin-pwa/react"],
		"noEmit": true
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",

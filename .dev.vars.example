# Copy to apps/api/.dev.vars and fill in. Never commit the real file.
# In production set each of these with `wrangler secret put <KEY>`.

# Public origin of this deployment. OAuth redirect URIs are derived from it.
APP_ORIGIN="http://localhost:5173"

# storage-first (default) | account-first  — see docs/PLAN.md §6
AUTH_MODE="storage-first"

# Any of: gdrive,onedrive,dropbox,webdav. `dropbox` and `onedrive` are
# implemented — gdrive is Phase 4, webdav Phase 5 — and each one listed here
# must have its credentials below or the app refuses to boot.
ENABLED_PROVIDERS="dropbox"

# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Checked at boot: anything that does not decode to exactly 32 bytes is refused
# there rather than at the first attempt to connect an account.
SECRETS_KEY=""
# Names the current key so rows encrypted with an older one stay readable.
SECRETS_KEY_ID="k1"

# Let the WebDAV proxy reach private/LAN addresses (e.g. a Nextcloud on your
# network). Leave false on any instance reachable from the internet.
WEBDAV_ALLOW_PRIVATE="false"

# Google Cloud console — required when ENABLED_PROVIDERS includes gdrive
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Entra app registration — required when ENABLED_PROVIDERS includes onedrive.
# The registration's display name must be "skysa-notes": OneDrive derives the
# app folder name from it. Supported account types: "Accounts in any
# organizational directory and personal Microsoft accounts". Add a *Web*
# platform (not SPA — the exchange happens on this server, with the secret)
# with this redirect URI:
#   <APP_ORIGIN>/api/auth/connect/onedrive/callback
# Delegated Microsoft Graph permissions: Files.ReadWrite.AppFolder,
# offline_access, openid, email. Create a client secret and put its *value*
# here; it expires, so note when.
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# common (personal and work accounts), consumers, organizations, or a tenant id.
MICROSOFT_TENANT="common"

# Dropbox App Console — required when ENABLED_PROVIDERS includes dropbox.
# Create the app with the name "skysa-notes"; Dropbox app names are immutable.
# Choose Scoped access / App folder, grant the five storage scopes listed in
# apps/api/src/oauth/dropbox.ts, and register this redirect URI:
#   <APP_ORIGIN>/api/auth/connect/dropbox/callback
DROPBOX_CLIENT_ID=""
DROPBOX_CLIENT_SECRET=""

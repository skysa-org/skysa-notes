root = true

# Matches .prettierrc.json: tabs shown four wide. Prettier formats every file
# it reaches, so this is for what it does not — and for the editor's first
# keystroke before a format on save.
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = tab
indent_size = 4
trim_trailing_whitespace = true

# Prettier writes YAML with spaces whatever `useTabs` says, since YAML forbids
# tabs for indentation.
[*.{yml,yaml}]
indent_style = space
indent_size = 4

# Markdown is prettier-ignored and hand-formatted, with two-space list
# indents. Trailing spaces can be a hard line break there.
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Generated by drizzle-kit, as it writes them.
[apps/api/migrations/meta/*.json]
indent_style = space
indent_size = 2

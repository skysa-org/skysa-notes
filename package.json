{
	"name": "skysa-notes",
	"private": true,
	"license": "AGPL-3.0-only",
	"type": "module",
	"packageManager": "pnpm@10.34.5",
	"engines": {
		"node": ">=22.13"
	},
	"scripts": {
		"setup": "sh scripts/setup.sh",
		"dev": "pnpm -r --parallel run dev",
		"build": "pnpm --filter @skysa/core run build && pnpm --filter @skysa/web run build && pnpm --filter @skysa/api run build",
		"test": "pnpm -r run test",
		"coverage": "vitest run --coverage --testTimeout=20000",
		"size": "pnpm --filter @skysa/web run size",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "pnpm -r run typecheck && tsc -p tsconfig.json",
		"db:migrate": "pnpm --filter @skysa/api run db:migrate",
		"db:migrate:remote": "pnpm --filter @skysa/api run db:migrate:remote",
		"lint:fix": "eslint . --fix",
		"knip": "knip",
		"verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
		"deploy": "pnpm typecheck && pnpm build && pnpm --filter @skysa/api run deploy",
		"changeset": "changeset",
		"changeset:status": "changeset status",
		"changeset:version": "changeset version"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@skysa/eslint-config": "1.1.0",
		"@vitest/coverage-v8": "^5.0.3",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"knip": "^6.42.1",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"vitest": "catalog:"
	}
}
